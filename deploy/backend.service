[Unit]
Description=Smplat Backend FastAPI Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=<your-linux-user>
WorkingDirectory=/home/<your-linux-user>/smplat/backend
ExecStart=/home/<your-linux-user>/smplat/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5s
Environment="PYTHONUNBUFFERED=1"
Environment="ENV_FILE=/home/<your-linux-user>/smplat/backend/.env"

[Install]
WantedBy=multi-user.target
